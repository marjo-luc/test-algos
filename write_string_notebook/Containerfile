# Jupyter notebook entrypoint, executed via papermill.
# COPY paths are relative to the REPO ROOT -- the Action builds with context: .
FROM python:3.12-slim

COPY ./write_string_notebook/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && python3 -m ipykernel install --name python3

COPY ./write_string_notebook/write_string_to_file.ipynb /app/write_string_to_file.ipynb
COPY ./write_string_notebook/run.py /usr/local/bin/run.py

RUN chmod +x /usr/local/bin/run.py
