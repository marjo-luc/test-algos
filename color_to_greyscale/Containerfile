# Python script entrypoint.
# COPY paths are relative to the REPO ROOT -- the Action builds with context: .
FROM python:3.12-slim

COPY ./color_to_greyscale/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY ./color_to_greyscale/color_to_greyscale.py /usr/local/bin/color_to_greyscale.py

RUN chmod +x /usr/local/bin/color_to_greyscale.py

# run_command: color_to_greyscale.py
# No CMD/ENTRYPOINT on purpose -- CWL supplies baseCommand plus the bound --flag args.
